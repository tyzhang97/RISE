{
  "atlas_repo": "../rise/atlas_repo",
  "dataset_name": "HCP",
  "output_root": "../data/HCP/processed_data",
  "subject_files": ["../data/HCP/info/hcp_ids.csv"],

  // These fields reproduce the time-series suffix generated by the HCP workflow.
  "atlas_name": "Fine-grained",
  "space": "MNI152NLin6Asym",
  "high_pass_hz": 0.01,
  "low_pass_hz": 0.25,
  "smoothing_fwhm_mm": 4,
  "detrend": true,
  "gsr_modes": ["NGR", "GSR"],

  // Shared resources and parameters for parcel-level feature extraction.
  "cortical_atlas": "Fine-grained",
  "subcortical_atlas": "Tianye",
  "cerebellar_atlas": "Buckner",
  "network_atlases": ["Yeo7", "Yeo17", "PFM_networks"],
  "resolution": "2mm",
  "gradient_components": 20,
  "gradient_embedding_components": 30,
  "gradient_sparsity": 0.9,
  "gradient_n_iter": 10,

  //  Parameters for hctsa dynamics feature extraction.
  "hctsa_root": "../hctsa_repo",
  "hctsa_mops_file": "../hctsa_repo/Database/INP_mops.txt",
  "hctsa_ops_file": "../hctsa_repo/Database/Top49_INP_ops.txt",
  "matlab_function": "ts_hctsa_workers",
  "matlab_do_pool": false,
  "matlab_workers": 16,
  "n_jobs": 10,
  "temporary_directory": "/dev/shm",
  "skip_existing": true
}
