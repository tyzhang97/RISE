{
  "atlas_repo": "../rise/atlas_repo", // Atlas data directory; paths are resolved relative to this file.
  "dataset_name": "clinical", // Example dataset label recorded in extraction metadata.
  "dataset_root": "../data/clinical/fmriprep_outputs", // Set to your fMRIPrep derivatives root.
  "output_root": "../data/clinical/processed_data", // Output root, resolved relative to this configuration file.
  "atlas_cache": "../data/clinical/atlas_cache", // Cache for atlases resampled to the input BOLD grid.
  "confound_format": "fmriprep", // Use fMRIPrep confounds instead of the HCP-style no-confound input.
  "confound_strategy": { // Example load_confounds settings: motion and WM/CSF are selected; global_signal is inactive unless added to strategy.
    "strategy": ["motion", "wm_csf"],
    "motion": "full",
    "wm_csf": "basic",
    "global_signal": "basic"
  },
  "fmriprep": { // BIDS/fMRIPrep filename components used by build_fmriprep_run_inputs.
    "session": "ses-1",
    "task": "rest",
    "space": "MNI152NLin6Asym",
    "resolution": "2"
  },
  "space": "MNI152NLin6Asym", // Standard space used to select atlas files and name outputs.
  "resolution": "2mm", // Atlas voxel resolution used for extraction.
  "atlases": [ // Atlases from which regional time series are extracted.
    "Fine-grained",
    "Tianye",
    "Buckner"
  ],
  "smooth_atlases": [ // Atlases extracted from the spatially smoothed BOLD image.
    "Fine-grained",
    "Tianye",
    "Buckner"
  ],
  "fill_zero_atlases": [ // Because the atlas is highly fine-grained, neighborhood interpolation is applied during time-series extraction to prevent individual parcels in some subjects from having no valid signal.
    "Fine-grained"
  ],
  "brain_mask": "MNI/MNI152NLin2009cAsym/mni_icbm152_t1_tal_nlin_asym_09c_mask_2mm.nii.gz", // Brain mask path relative to the packaged or overridden atlas repository.
  "tr": 2.0, // Example repetition time in seconds; set to the value in your acquisition metadata.
  "high_pass_hz": 0.01, // High-pass cutoff in Hz for time-series cleaning and ReHo input.
  "low_pass_hz": 0.25, // Low-pass cutoff in Hz for time-series cleaning and ReHo input.
  "smoothing_fwhm_mm": 8, // Example spatial smoothing FWHM in mm; adjust for your analysis.
  "temporary_directory": "/dev/shm", // Temporary directory for filtered BOLD images used by ReHo.
  "detrend": true, // Whether to remove linear trends during signal cleaning.
  "compute_reho_alff_falff": true, // Whether to calculate ReHo, ALFF, and fALFF maps.
  "falff_low_frequency_hz": 0.01, // Lower frequency bound in Hz for ALFF and fALFF.
  "falff_high_frequency_hz": 0.08, // Upper frequency bound in Hz for ALFF and fALFF.
  "gsr_modes": [ // Output modes: true uses motion+WM/CSF plus the custom RISE global signal; false uses motion+WM/CSF only.
    true,
    false
  ],
  "skip_existing": false, // Skip runs whose saved parameters match the current parameters.
  "n_processes": 8, // Number of worker processes used for dataset extraction.
  "runs": [
    {
      "run": "run-1", // BIDS run label in the fMRIPrep filename.
      "output_name": "ses-1_task-rest_run-1" // Standardized output label.
    }
  ]
}
